{
  "name": "linear-axi",
  "version": "0.1.0",
  "description": "AXI-compliant Linear CLI wrapping @linear/sdk — token-efficient TOON output for agents",
  "type": "module",
  "keywords": [
    "linear",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "linear-axi": "./dist/bin/linear-axi.js"
  },
  "files": [
    "dist",
    "skills/linear-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin/linear-axi.js",
